# Only what is listed here is part of the repository. Everything else at the top level stays
# out: the game and anything made from it (extracted files, saves, logs, screenshots, render
# target and audio dumps), build output, downloaded toolchains and other people's packages.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/.github/
!/README.md
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/run.bat
!/Play Rush of Blood (DualSense).bat
!/shadps4-arm64-main/

# The PC play folder: only the launcher, its settings and the clean starting files of a release
# (pc-vr/template), not the emulator built into it, nor its user folder (saves, logs, shader
# cache).
!/pc-vr/
/pc-vr/*
!/pc-vr/launch.ps1
!/pc-vr/settings.txt
!/pc-vr/template/

# Scripts yes, toolchains and downloads no (clang, CMake, Ninja, Windows SDK, sysroot, jadx,
# PkgTool: see tools/make-release.ps1).
!/tools/
/tools/*/
!/tools/probes/
!/tools/re/
!/tools/shims/
!/tools/tests/
/tools/*.local

# Never anywhere: game files and packages.
*.pkg
*.apk
*.sfo
*.sprx
*.prx
eboot.bin
sce_sys/
sce_module/
savedata/
shadps4.map
